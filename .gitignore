# ----------------------------
# Python cache / bytecode
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc

# ----------------------------
# Build / packaging
# ----------------------------
dist/
build/
*.egg-info/

# ----------------------------
# Virtual environments
# ----------------------------
.venv/
env/
venv/
ENV/
.env

# ----------------------------
# IDE/editor
# ----------------------------
.vscode/
.idea/
.local/
.codex/

# ----------------------------
# Databases (NEVER COMMIT)
# ----------------------------
data/*.db
*.db
*.sqlite3

# Backups
data/backups/

# ----------------------------
# Raw import files (Excel, CSV)
# ----------------------------
data/import/
*.xlsx
*.xls
*.csv

# ----------------------------
# Docker / runtime artifacts
# ----------------------------
*.pid
*.sock

# ----------------------------
# Logs
# ----------------------------
*.log

# ----------------------------
# PyInstaller
# ----------------------------
*.spec

# ----------------------------
# macOS junk
# ----------------------------
.DS_Store

# ----------------------------
# Legacy data artifacts (intentionally ignored)
# ----------------------------
legacy/

# Legacy documentation archive (intentionally tracked)
!docs/legacy/
!docs/legacy/**.codex/
